{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Package-specific override: the worker embeds apps/web's dist into its own
    // (scripts/copy-public.mjs). Turbo alone builds/restores the dashboard;
    // direct worker builds enter this same graph via write-build-info.mjs.
    // Scoped to the worker only: applied globally, every package's build
    // would depend on web and the graph would cycle.
    "@better-trigger/worker#build": {
      "dependsOn": ["^build", "@better-trigger/web#build"],
      "outputs": ["dist/**"],
      // Build identity depends on the live Git checkout (including dirty
      // state), which Turbo cannot model as a stable file/env input. Never
      // restore a worker bundle stamped by another checkout. Declaring the
      // trusted CI/Docker inputs still makes them available in strict env
      // mode and documents every environment value that changes the bundle.
      "cache": false,
      "env": ["BT_GIT_SHA", "GIT_SHA"]
    },
    // The VitePress site outputs under .vitepress/dist, not dist/ — declare it
    // so turbo can cache the docs build like any other.
    "@better-trigger/docs#build": {
      "outputs": [".vitepress/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    // Root-level counterpart: the repo-root scripts (bump-versions, the
    // packaging/drift guards) and the shared configs live outside every
    // workspace, so no workspace lint glob reaches them. Linted here so the
    // "one baseline for the whole repo" claim in eslint.config.mjs holds.
    "//#lint:root": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // The kernel's true-Postgres suites (test/pg) gate on DATABASE_URL and
      // skip when unset; CI provisions a postgres service and needs the var to
      // reach the task. `env` (not passThroughEnv) so the presence of
      // DATABASE_URL is part of the task hash — a no-Postgres run must never
      // be served from cache to a run that should exercise the pg suites.
      "env": ["DATABASE_URL"]
    },
    "test:acceptance": {
      "dependsOn": ["^build"],
      "cache": false,
      // Turbo's strict env mode would otherwise hide DATABASE_URL from the
      // scenarios, which then silently fall back to the default local URL —
      // i.e. CI would gate on whatever database happened to be reachable,
      // and pointing DATABASE_URL at a broken host would still exit 0.
      // BT_* covers the per-scenario BT_*_DB / BT_*_PORT / BT_WORKER_ENTRY
      // overrides documented in each script's header.
      "passThroughEnv": ["DATABASE_URL", "BT_*"]
    }
  }
}
