# better-trigger — local development environment.
# Copy to .env and adjust as needed:  cp .env.example .env
#
# The single source of truth for the BETTER_TRIGGER_* knobs below is
# apps/worker/src/env-registry.ts — main.ts renders `--help` from it, and the
# anti-drift test apps/worker/test/env-registry.test.ts guards it against the
# source (a new env read without a registry entry fails the test).
#
# Only the worker daemon reads DATABASE_URL. Applications talk to the daemon
# over HTTP (BETTER_TRIGGER_URL) and never see a connection string.

# --- worker daemon (@better-trigger/worker) ---

# Postgres connection. Matches `docker compose up -d` defaults.
# Default if unset: postgres://localhost:5432/better_trigger
DATABASE_URL=postgres://postgres:postgres@localhost:5432/better_trigger

# HTTP port the daemon listens on. Default: 4848
PORT=4848

# ---- core ----

# Concurrent execution slots. Default: 5
# BETTER_TRIGGER_CONCURRENCY=5

# Require `Authorization: Bearer <key>` on the API.
# Unset = local mode, no auth. Set it and the SDK needs the same value.
# May carry a @YYYY-MM-DD expiry suffix (sk-abc@2027-01-01) → 401 key_expired past it.
# BETTER_TRIGGER_API_KEY=change-me

# Additional bearer keys, comma-separated (each may carry the same @date suffix).
# Any configured key authenticates — this is how key rotation works: add the
# new key here, wait for old requests to drain, then remove the old one.
# BETTER_TRIGGER_API_KEYS=

# 1/true = claim only runs stamped with the code version this process serves
# for that task (same as --pin-code-version). A run whose task was edited
# mid-flight stays queued instead of being handed to code that will drift.
# BETTER_TRIGGER_PIN_CODE_VERSION=1

# Code version reported on registration, overriding the build identity
# (0.1.0+<git sha>) — name deploys as your pipeline does.
# BETTER_TRIGGER_VERSION=0.1.0+my-git-sha

# ---- network posture ----

# Bind address (same as --host). Default: 127.0.0.1 — loopback only, so only
# this machine can reach the API. Use 0.0.0.0 to accept network connections
# (the Docker image already sets this).
# BETTER_TRIGGER_HOST=127.0.0.1

# 1/true = same as --allow-unauthenticated: permit a non-loopback --host
# without an API key. Off by default — that combination refuses to start.
# The four-network-posture knobs (HOST / ALLOW_UNAUTHENTICATED / CORS_ORIGIN /
# NAMESPACES) are the offline-deployment set a container cannot configure by
# flag, so they belong in the image env.
# BETTER_TRIGGER_ALLOW_UNAUTHENTICATED=1

# Extra browser origins allowed to call the API, comma-separated (same as
# --cors-origin). localhost / 127.0.0.1 / [::1] on any port are always
# allowed; * allows any origin.
# BETTER_TRIGGER_CORS_ORIGIN=https://ops.example.com

# Namespaces this worker serves, comma-separated <projectId>/<env> pairs
# (same as --namespace). Default: default/prod — the namespace every
# pre-namespace row lives in.
# BETTER_TRIGGER_NAMESPACES=acme/prod,acme/staging

# ---- limits ----

# The byte-limit caps below are fully documented, with defaults and refusal
# behaviour, in apps/worker/README.md#request-limits (one env var each, raised
# the same way — absent / zero / negative / unparseable falls back to default):
#   BETTER_TRIGGER_BODY_LIMIT  BETTER_TRIGGER_MAX_BATCH
#   BETTER_TRIGGER_MAX_BATCH_PAYLOAD_BYTES  BETTER_TRIGGER_MAX_PAYLOAD_BYTES
#   BETTER_TRIGGER_STEP_OUTPUT_MAX_BYTES  BETTER_TRIGGER_RUN_OUTPUT_MAX_BYTES
#   BETTER_TRIGGER_ERROR_MAX_BYTES  BETTER_TRIGGER_LOG_DATA_MAX_BYTES
#   BETTER_TRIGGER_LOG_MESSAGE_MAX_BYTES  BETTER_TRIGGER_LOG_BATCH_MAX_BYTES

# Cap on a run's replayed step ledger. A run past the cap fails with a
# non-retryable AbortError — split the task with continueAsNew before it grows
# this large. 0 = unlimited. Default: 10000
# BETTER_TRIGGER_MAX_STEPS=10000

# Reaper recovery budget stamped on new runs. A run recovered more than this
# is failed rather than requeued. 0 = never recover a lost run (fail it the
# moment its lease expires). Default: 10
# BETTER_TRIGGER_MAX_RECOVERIES=10

# ---- rate limiting ----

# Token-bucket rate limits on trigger / batch-trigger / retry / cancel
# (0 disables the bucket; in-memory per process — an exact fleet-wide cap
# belongs at the reverse proxy):
#   per-key per-endpoint rate (default 50/s)
#   BETTER_TRIGGER_RATE_LIMIT_RPS=50
#   per-endpoint rate over all keys (default 200/s)
#   BETTER_TRIGGER_RATE_LIMIT_GLOBAL_RPS=200
#   bucket capacity / burst (default: the larger rate above)
#   BETTER_TRIGGER_RATE_LIMIT_BURST=200
# Looser limits on the read surface (/api/v1 reads — /runs/:id/record,
# /runs/:id/result, /runs, /tasks, /schedules, /workers, /metrics), which
# bound an attack but must never throttle a polling dashboard:
#   per-key read rate (default 200/s)
#   BETTER_TRIGGER_RATE_LIMIT_READ_RPS=200
#   read rate over all keys (default 1000/s)
#   BETTER_TRIGGER_RATE_LIMIT_READ_GLOBAL_RPS=1000

# ---- tuning ----

# Business-pool connection max. Derived by default: --concurrency + 8 (headroom
# for the orchestrator loops / heartbeat / waiter sweep / HTTP slack). Raise it
# when better_trigger_pool_checkout_timeouts_total climbs.
# BETTER_TRIGGER_POOL_MAX=20

# Business-pool checkout / connect timeout in ms. A saturated pool answers a
# checkout with an error after this instead of queueing it forever; each one is
# counted on better_trigger_pool_checkout_timeouts_total.
# 0 = a checkout waits forever (pg's default). Default: 10000
# BETTER_TRIGGER_POOL_CONNECT_TIMEOUT_MS=10000

# Server-side statement timeout in ms (sent as statement_timeout in the
# connection startup packet): PostgreSQL itself cancels a query that runs
# longer and returns the connection to the pool. 0 = off. Default: 30000
# BETTER_TRIGGER_POOL_STATEMENT_TIMEOUT_MS=30000

# Default off: a stray unhandledRejection (usually a non-awaited promise in
# task code) is logged and counted on better_trigger_unhandled_rejections_total
# while the daemon keeps serving. Set to 1 to make it fatal like an
# uncaughtException.
# BETTER_TRIGGER_FATAL_UNHANDLED_REJECTION=1

# Cache TTL for /tasks stats, per namespace. 0 disables the cache.
# Default: 10000
# BETTER_TRIGGER_STATS_TTL_MS=10000

# --- applications (better-trigger SDK) ---

# Worker daemon the SDK triggers against. Default: http://localhost:4848
BETTER_TRIGGER_URL=http://localhost:4848

# --- dashboard web UI (apps/web) ---

# Same daemon, for the Vite dev server. Default: http://localhost:4848
# Leave unset for same-origin access (the production build the daemon serves
# talks to its own origin); uncomment to pin the dashboard to another daemon
# in local dev. Not part of the worker env registry.
# VITE_BT_API_URL=http://localhost:4848

# Local-development API key baked into the dashboard bundle — NOT safe for
# public deployments (the key ships in the client). Provide the same value as
# BETTER_TRIGGER_API_KEY above so the dashboard can call the daemon.
# See apps/web/README.md. Not part of the worker env registry.
# VITE_BT_API_KEY=local-dev-secret
