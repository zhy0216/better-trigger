# better-trigger — local development environment.
# Copy to .env and adjust as needed:  cp .env.example .env

# --- server (@better-trigger/server) ---

# Postgres connection. Matches `docker compose up -d` defaults.
# Default if unset: postgres://localhost:5432/better_trigger
DATABASE_URL=postgres://postgres:postgres@localhost:5432/better_trigger

# HTTP port the server listens on. Default: 4848
PORT=4848

# Require `Authorization: Bearer <key>` on the API.
# Unset = local mode, no auth. If set, export the same value for the
# worker and the e2e script.
# BETTER_TRIGGER_API_KEY=change-me

# --- worker + e2e (examples/basic) ---

# Where the SDK/worker/e2e script reach the server. Default: http://localhost:4848
BETTER_TRIGGER_API_URL=http://localhost:4848

# --- dashboard (apps/web) ---

# API base URL for the Vite dev server. Default: http://localhost:4848
VITE_BT_API_URL=http://localhost:4848
