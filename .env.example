# better-trigger — local development environment.
# Copy to .env and adjust as needed:  cp .env.example .env
#
# Only the worker daemon reads DATABASE_URL. Applications talk to the daemon
# over HTTP (BETTER_TRIGGER_URL) and never see a connection string.

# --- worker daemon (@better-trigger/worker) ---

# Postgres connection. Matches `docker compose up -d` defaults.
# Default if unset: postgres://localhost:5432/better_trigger
DATABASE_URL=postgres://postgres:postgres@localhost:5432/better_trigger

# HTTP port the daemon listens on. Default: 4848
PORT=4848

# Concurrent execution slots. Default: 5
# BETTER_TRIGGER_CONCURRENCY=5

# Require `Authorization: Bearer <key>` on the API.
# Unset = local mode, no auth. Set it and the SDK needs the same value.
# May carry a @YYYY-MM-DD expiry suffix (sk-abc@2027-01-01) → 401 key_expired past it.
# BETTER_TRIGGER_API_KEY=change-me

# Additional bearer keys, comma-separated (each may carry the same @date suffix).
# Any configured key authenticates — this is how key rotation works: add the
# new key here, wait for old requests to drain, then remove the old one.
# BETTER_TRIGGER_API_KEYS=

# Token-bucket rate limits on trigger / batch-trigger / retry / cancel
# (0 disables the bucket; in-memory per process — an exact fleet-wide cap
# belongs at the reverse proxy):
#   per-key per-endpoint rate (default 50/s)
#   BETTER_TRIGGER_RATE_LIMIT_RPS=50
#   per-endpoint rate over all keys (default 200/s)
#   BETTER_TRIGGER_RATE_LIMIT_GLOBAL_RPS=200
#   bucket capacity / burst (default: the larger rate above)
#   BETTER_TRIGGER_RATE_LIMIT_BURST=200

# --- applications (better-trigger SDK) ---

# Worker daemon the SDK triggers against. Default: http://localhost:4848
BETTER_TRIGGER_URL=http://localhost:4848

# --- dashboard web UI (apps/web) ---

# Same daemon, for the Vite dev server. Default: http://localhost:4848
VITE_BT_API_URL=http://localhost:4848
