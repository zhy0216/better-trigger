# better-trigger — local development environment.
# Copy to .env and adjust as needed:  cp .env.example .env
#
# The SDK is embedded: apps/workers connect straight to Postgres via
# DATABASE_URL — there is no worker API URL.

# --- everything (SDK, examples, dashboard API) ---

# Postgres connection. Matches `docker compose up -d` defaults.
# Default if unset: postgres://localhost:5432/better_trigger
DATABASE_URL=postgres://postgres:postgres@localhost:5432/better_trigger

# --- dashboard API (@better-trigger/server, optional) ---
# Serves the REST API for apps/web only; it does not orchestrate or run tasks.

# HTTP port the dashboard API listens on. Default: 4848
PORT=4848

# Require `Authorization: Bearer <key>` on the dashboard API.
# Unset = local mode, no auth.
# BETTER_TRIGGER_API_KEY=change-me

# --- dashboard web UI (apps/web) ---

# Dashboard API base URL for the Vite dev server. Default: http://localhost:4848
VITE_BT_API_URL=http://localhost:4848
