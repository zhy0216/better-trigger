{
  "name": "@better-trigger/worker",
  "version": "0.1.0",
  "description": "better-trigger worker — the local daemon: loads your tasks, executes them durably against Postgres, and serves the HTTP API the SDK and dashboard talk to",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "better-trigger-worker": "./dist/main.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@better-trigger/core": "workspace:*",
    "@better-trigger/db": "workspace:*",
    "@better-trigger/kernel": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "better-trigger": "workspace:*",
    "hono": "^4.6.13",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}
