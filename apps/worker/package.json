{
  "name": "@better-trigger/worker",
  "version": "0.1.0",
  "description": "better-trigger worker runtime — run as a local daemon or embed it in a Node/Bun application; executes tasks durably against Postgres",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./embedded": {
      "import": {
        "types": "./dist/embedded.d.ts",
        "default": "./dist/embedded.js"
      },
      "require": {
        "types": "./dist/embedded.d.cts",
        "default": "./dist/embedded.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "embedded": ["./dist/embedded.d.ts"]
    }
  },
  "bin": {
    "better-trigger-worker": "./dist/main.js"
  },
  "files": ["dist"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhy0216/better-trigger.git",
    "directory": "apps/worker"
  },
  "homepage": "https://github.com/zhy0216/better-trigger#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun scripts/write-build-info.mjs && tsdown && bun scripts/copy-public.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern '**/*.{js,jsx,mjs,cjs}'",
    "dev": "bun --watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-trigger/core": "workspace:*",
    "@better-trigger/db": "workspace:*",
    "@better-trigger/kernel": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-trigger": "workspace:*",
    "hono": "^4.13.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
