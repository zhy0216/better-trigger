{
  "name": "better-trigger",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhy0216/better-trigger.git"
  },
  "homepage": "https://github.com/zhy0216/better-trigger#readme",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "eslint scripts eslint.config.mjs apps/docs/validate-mermaid.mjs apps/docs/.vitepress/config.mts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:acceptance": "turbo run test:acceptance",
    "check:deps": "node scripts/check-deps.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "check:exports": "publint --strict packages/core && publint --strict packages/db && publint --strict packages/kernel && publint --strict packages/sdk && publint --strict apps/worker && attw --pack packages/core && attw --pack packages/db && attw --pack packages/kernel && attw --pack packages/sdk && attw --pack apps/worker"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "publint": "^0.3.24",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
