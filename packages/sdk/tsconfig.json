{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "vitest.config.ts"],
  // test/lifecycle-selftest.ts is a pre-split bun script (needs a live
  // Postgres, predates the client/daemon split) — see vitest.config.ts.
  "exclude": ["test/lifecycle-selftest.ts"]
}
