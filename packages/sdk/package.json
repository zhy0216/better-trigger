{
  "name": "better-trigger",
  "version": "0.1.0",
  "description": "Type-safe, self-hostable durable task orchestration for TypeScript. Declare tasks, run durable steps, wait for hours or days. Your app only speaks HTTP — the worker daemon owns Postgres.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "internal": ["./dist/internal.d.ts"]
    }
  },
  "files": ["dist", "README.md"],
  "keywords": [
    "trigger",
    "background-jobs",
    "durable-execution",
    "workflow",
    "task-queue",
    "cron",
    "postgres",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhy0216/better-trigger.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/zhy0216/better-trigger#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern '**/*.{js,jsx,mjs,cjs}'",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-trigger/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
