{
  "name": "@better-trigger/kernel",
  "version": "0.1.0",
  "description": "better-trigger kernel — durable execution engine over Postgres (queue, runs, orchestrator). Internal: consumed by apps/worker, never by the SDK.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-trigger/core": "workspace:*",
    "croner": "^9.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}
