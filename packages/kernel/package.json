{
  "name": "@better-trigger/kernel",
  "version": "0.1.0",
  "description": "better-trigger kernel — durable execution engine over Postgres (queue, runs, orchestrator). Internal: consumed by apps/worker, never by the SDK.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhy0216/better-trigger.git",
    "directory": "packages/kernel"
  },
  "homepage": "https://github.com/zhy0216/better-trigger#readme",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern '**/*.{js,jsx,mjs,cjs}'",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-trigger/core": "workspace:*",
    "croner": "^10.0.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@better-trigger/db": "workspace:*",
    "@better-trigger/testing": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
